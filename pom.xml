<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.c2smart</groupId>
  <artifactId>matsim-nyc-modernized</artifactId>
  <version>1.0.0</version>
  <name>C2SMART MATSim-NYC modernized</name>
  <description>Modernized runner around the public C2SMART MATSim-NYC baseline scenario.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <matsim.build.directory>target</matsim.build.directory>
    <matsim.version>2026.0</matsim.version>
  </properties>

  <repositories>
    <repository>
      <id>matsim</id>
      <name>MATSim Maven repository</name>
      <url>https://repo.matsim.org/repository/matsim/</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.matsim</groupId>
      <artifactId>matsim</artifactId>
      <version>${matsim.version}</version>
    </dependency>
    <dependency>
      <groupId>org.matsim.contrib</groupId>
      <artifactId>sbb-extensions</artifactId>
      <version>${matsim.version}</version>
    </dependency>
    <dependency>
      <groupId>org.matsim.contrib</groupId>
      <artifactId>roadpricing</artifactId>
      <version>${matsim.version}</version>
    </dependency>
  </dependencies>

  <build>
    <directory>${matsim.build.directory}</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>org.c2smart.matsimnyc.RunNyc</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
